+// namePriority pins web and taskiq names ahead of the usual panel ordering.
+func namePriority(name string) int {
+	switch {
+	case strings.Contains(name, "web"):
+		return 0
+	case strings.Contains(name, "taskiq"):
+		return 1
+	default:
+		return 2
+	}
+}
+
 func sortContainers(a *commands.Container, b *commands.Container, legacySort bool) bool {
+	if left, right := namePriority(a.Name), namePriority(b.Name); left != right {
+		return left < right
+	}
+
 	if legacySort {
 		return a.Name < b.Name
 	}
