+static gboolean dismiss_if_inactive(gpointer data) {
+	if(!gtk_window_is_active(GTK_WINDOW(data))) {
+		gtk_main_quit();
+	}
+	return G_SOURCE_REMOVE;
+}
+
+static void dismiss_on_deactivate(GObject* object, GParamSpec* pspec, gpointer data) {
+	(void) pspec;
+	(void) data;
+	// Wait for internal focus transitions to settle before dismissing.
+	if(!gtk_window_is_active(GTK_WINDOW(object))) {
+		g_idle_add(dismiss_if_inactive, object);
+	}
+}
