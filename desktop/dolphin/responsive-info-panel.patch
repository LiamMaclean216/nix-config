+
+void DolphinMainWindow::scheduleInformationPanelUpdate()
+{
+    if (m_informationPanelUpdatePending) {
+        return;
+    }
+    m_informationPanelUpdatePending = true;
+    // Measure after the dock layout and file viewport have received their sizes.
+    QTimer::singleShot(0, this, [this] {
+        m_informationPanelUpdatePending = false;
+        updateInformationPanelVisibility();
+    });
+}
+
+void DolphinMainWindow::setInformationPanelPreference(bool visible)
+{
+    KConfigGroup settings(KSharedConfig::openConfig(), QStringLiteral("InformationPanel"));
+    if (!settings.hasKey("ResponsiveVisible") || settings.readEntry("ResponsiveVisible", !visible) != visible) {
+        settings.writeEntry("ResponsiveVisible", visible);
+        settings.sync();
+    }
+}
+
+void DolphinMainWindow::updateInformationPanelVisibility()
+{
+#if HAVE_BALOO
+    if (!isVisible() || isMinimized() || !m_activeViewContainer) {
+        return;
+    }
+    auto *dock = findChild<DolphinDockWidget *>(QStringLiteral("infoDock"));
+    if (!dock || dock->isFloating() || (!dock->isVisible() && !m_informationPanelAutoHidden)) {
+        return;
+    }
+    DolphinView *view = m_activeViewContainer->view();
+    auto *container = view->findChild<KItemListContainer *>();
+    if (!container || !container->controller()->view()) {
+        return;
+    }
+
+    const int characterWidth = view->fontMetrics().averageCharWidth();
+    qreal minimumFileWidth = std::max(360, characterWidth * 48);
+    if (view->viewMode() == DolphinView::DetailsView) {
+        const auto *listView = container->controller()->view();
+        const auto *header = listView->header();
+        // Reserve a readable filename area in addition to the actual metadata
+        // columns, rather than assuming every window has the same sidebar size.
+        minimumFileWidth = std::max(280, characterWidth * 32) + header->leftPadding() + header->rightPadding();
+        for (const QByteArray &role : listView->visibleRoles()) {
+            if (role != QByteArrayLiteral("text")) {
+                minimumFileWidth += header->columnWidth(role);
+            }
+        }
+    }
+
+    const int viewportWidth = container->viewport()->width();
+    const int separatorWidth = style()->pixelMetric(QStyle::PM_DockWidgetSeparatorExtent);
+    const int hysteresis = std::max(80, characterWidth * 10);
+    if (m_informationPanelAutoHidden) {
+        if (viewportWidth - m_informationPanelWidth - separatorWidth < minimumFileWidth + hysteresis) {
+            return;
+        }
+        m_informationPanelResponsiveChange = true;
+        m_informationPanelAutoHidden = false;
+        dock->show();
+        resizeDocks({dock}, {m_informationPanelWidth}, Qt::Horizontal);
+        m_informationPanelResponsiveChange = false;
+    } else if (viewportWidth < minimumFileWidth) {
+        m_informationPanelWidth = dock->width();
+        setInformationPanelPreference(true);
+        m_informationPanelResponsiveChange = true;
+        m_informationPanelAutoHidden = true;
+        dock->hide();
+        // Keep F11/menu checked for the logical preference. Toggling it while
+        // collapsed explicitly disables the panel and cancels auto-restoration.
+        dock->toggleViewAction()->setChecked(true);
+        m_informationPanelResponsiveChange = false;
+    }
+#endif
 }
 
