@@ -33,6 +33,33 @@
 #include <QClipboard>
 #include <QKeyEvent>
 #include <QAction>
+
+namespace
+{
+// Keep Ark's real actions and their extraction/error/trash handling. Only move
+// them out of the submenu; matching the theme icon also works across locales.
+QList<QAction *> takeArchiveActions(QMenu *menu)
+{
+    const auto menuActions = menu->actions();
+    for (QAction *action : menuActions) {
+        if (action->icon().name() == QLatin1String("archive-extract")) {
+            const auto archiveActions = action->menu() ? action->menu()->actions() : QList<QAction *>{action};
+            menu->removeAction(action);
+            return archiveActions;
+        }
+        if (QMenu *submenu = action->menu()) {
+            const auto archiveActions = takeArchiveActions(submenu);
+            if (!archiveActions.isEmpty()) {
+                if (submenu->isEmpty()) {
+                    menu->removeAction(action);
+                }
+                return archiveActions;
+            }
+        }
+    }
+    return {};
+}
+}
 
