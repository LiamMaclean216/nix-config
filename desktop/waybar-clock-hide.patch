 // Actions handler
+bool waybar::modules::Clock::handleToggle(GdkEventButton* const& e) {
+  const auto& seconds = config_["hide-on-click"];
+  if (e->button != 1 || !seconds.isUInt() || seconds.asUInt() == 0) {
+    return ALabel::handleToggle(e);
+  }
+  if (e->type != GDK_BUTTON_PRESS) return true;
+
+  // Only the rendered text rectangle is clickable, never the surrounding padding.
+  int x, y, label_x, label_y;
+  label_.get_layout_offsets(x, y);
+  if (!label_.translate_coordinates(event_box_, 0, 0, label_x, label_y)) return false;
+  Pango::Rectangle ink, logical;
+  label_.get_layout()->get_pixel_extents(ink, logical);
+  x += label_x + ink.get_x();
+  y += label_y + ink.get_y();
+  if (e->x < x || e->x >= x + ink.get_width() ||
+      e->y < y || e->y >= y + ink.get_height()) return false;
+
+  for (auto& bar : Client::inst()->bars) bar->hide();
+  // Do not retain a clock/bar pointer: a configuration reload can replace them.
+  Glib::signal_timeout().connect(
+      []() {
+        for (auto& bar : Client::inst()->bars) bar->show();
+        return false;
+      },
+      seconds.asUInt() * 1000);
+  return true;
+}
