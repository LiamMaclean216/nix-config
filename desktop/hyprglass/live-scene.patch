+// Run after animation advancement and before beginRender collects damage. Moving
+// a static client submits no surface damage, and window decorations may be disabled.
+static void updateLayerScene(PHLMONITOR monitor) {
+    if (!g_pGlobalState || !monitor)
+        return;
+
+    const auto& config = g_pGlobalState->config;
+    if (!config.layersEnabled || !**config.layersEnabled)
+        return;
+
+    const auto wantsLiveScene = [&](const auto& pair) {
+        const auto layer = pair.second->getLayerSurface();
+        return layer && layer->m_mapped && layer->m_monitor == monitor && pair.second->liveResampleEnabled();
+    };
+    if (std::ranges::none_of(g_pGlobalState->layerSurfaces, wantsLiveScene)) {
+        g_pGlobalState->layerSceneSnapshots.erase(monitor->m_id);
+        return;
+    }
+
+    GlassScene::Snapshot current;
+    for (const auto& window : Desktop::viewState()->windows()) {
+        if (!window || !window->m_isMapped || window->isHidden() ||
+            !g_pHyprRenderer->shouldRenderWindow(window, monitor))
+            continue;
+
+        const auto box = WindowGeometry::computeWindowBox(window, monitor);
+        if (!box || !std::isfinite(box->x) || !std::isfinite(box->y) ||
+            !std::isfinite(box->w) || !std::isfinite(box->h))
+            continue;
+
+        // Keep main geometry distinct from dependency bounds: dimAround's
+        // monitor-wide bounds stay fixed while the window body moves. Decoration
+        // extents also cover shadows, borders and client popups behind the glass.
+        auto bounds = *box;
+        bounds.addExtents(window->getFullWindowExtents() * monitor->m_scale).round();
+
+        float opacity = window->effectiveAlpha();
+        if (const auto workspace = window->m_workspace; workspace && !window->m_pinned)
+            opacity *= workspace->m_alpha->value();
+        const unsigned plane = (window->m_isFloating ? 1U : 0U) |
+                               (window->m_pinned ? 2U : 0U) | (window->onSpecialWorkspace() ? 4U : 0U);
+        current.push_back({reinterpret_cast<uintptr_t>(window.get()),
+                           {box->x, box->y, box->w, box->h},
+                           {bounds.x, bounds.y, bounds.w, bounds.h}, opacity, plane, current.size()});
+    }
+
+    // Closed clients continue rendering as animated snapshots. Follow their
+    // geometry/alpha too, until the last snapshot leaves the visible scene.
+    for (const auto& fade : Desktop::fadingOutState()->fadeouts()) {
+        if (!fade || fade->monitor() != monitor || fade->done() ||
+            (fade->plane() != Desktop::FADEOUT_PLANE_WINDOW_TILED &&
+             fade->plane() != Desktop::FADEOUT_PLANE_WINDOW_FLOATING &&
+             fade->plane() != Desktop::FADEOUT_PLANE_WINDOW_OVER_FULLSCREEN))
+            continue;
+        if (const auto workspace = fade->workspace().lock(); workspace && !workspace->isVisible())
+            continue;
+        auto box = fade->geometricBox(Desktop::View::IGeometric::GEOMETRIC_CURRENT);
+        box.translate(-monitor->m_position).scale(monitor->m_scale).round();
+        current.push_back({reinterpret_cast<uintptr_t>(fade.get()),
+                           {box.x, box.y, box.w, box.h},
+                           {box.x, box.y, box.w, box.h}, fade->alpha(),
+                           8U + static_cast<unsigned>(fade->plane()), static_cast<size_t>(fade->zIndex())});
+    }
+
+    auto& previous = g_pGlobalState->layerSceneSnapshots[monitor->m_id];
+    const auto damage = GlassScene::changedBounds(previous, current);
+    previous = std::move(current);
+    if (damage.empty())
+        return;
+
+    for (const auto& pair : g_pGlobalState->layerSurfaces) {
+        if (!wantsLiveScene(pair))
+            continue;
+        const auto box = LayerGeometry::computeLayerBox(pair.second->getLayerSurface(), monitor);
+        if (!box)
+            continue;
+        auto sample = *box;
+        sample.expand(GlassRenderer::SAMPLE_PADDING_PX);
+        if (GlassScene::affectsSample(damage, {sample.x, sample.y, sample.w, sample.h}))
+            pair.second->markBackgroundDirty(true);
     }
 }
 
