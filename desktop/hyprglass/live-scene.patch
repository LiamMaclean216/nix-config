+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+#include <unordered_map>
+
+// Geometry-only scene state: client commits are handled separately by damageSurface.
+// Keeping this independent of decorations also covers disabled window glass,
+// undecorated clients and windows leaving a monitor's visible scene.
+namespace GlassScene {
+struct Box {
+    double x, y, w, h;
+    bool operator==(const Box&) const = default;
+
+    bool overlaps(const Box& other) const {
+        return w > 0 && h > 0 && other.w > 0 && other.h > 0 &&
+               x < other.x + other.w && x + w > other.x &&
+               y < other.y + other.h && y + h > other.y;
+    }
+};
+
+struct Window {
+    uintptr_t identity;
+    Box box;
+    Box bounds;
+    float opacity;
+    unsigned plane;
+    size_t order;
+    bool operator==(const Window&) const = default;
+};
+using Snapshot = std::vector<Window>;
+
+// Keep old/new bounds separate: a window crossing a distant glass panel must
+// not dirty that panel just because it lies inside the bounds of the whole move.
+inline std::vector<Box> changedBounds(const Snapshot& previous, const Snapshot& current) {
+    std::unordered_map<uintptr_t, const Window*> oldById, nowById;
+    for (const auto& window : previous)
+        oldById.emplace(window.identity, &window);
+    for (const auto& window : current)
+        nowById.emplace(window.identity, &window);
+
+    std::vector<Box> damage;
+    for (const auto& old : previous) {
+        const auto it = nowById.find(old.identity);
+        if (it == nowById.end()) {
+            damage.push_back(old.bounds);
+        } else {
+            const auto& now = *it->second;
+            if (now.box != old.box || now.bounds != old.bounds || now.opacity != old.opacity || now.plane != old.plane)
+                damage.insert(damage.end(), {old.bounds, now.bounds});
+        }
+    }
+    for (const auto& now : current) {
+        if (!oldById.contains(now.identity))
+            damage.push_back(now.bounds);
+    }
+
+    // Absolute ranks shift when unrelated windows enter/leave a monitor. Only
+    // changed relative order between surviving windows changes their stacking.
+    for (size_t a = 0; a < previous.size(); ++a) {
+        const auto nowA = nowById.find(previous[a].identity);
+        if (nowA == nowById.end())
+            continue;
+        for (size_t b = a + 1; b < previous.size(); ++b) {
+            const auto nowB = nowById.find(previous[b].identity);
+            if (nowB == nowById.end() || previous[a].plane != previous[b].plane || nowA->second->plane != nowB->second->plane)
+                continue;
+            if ((previous[a].order < previous[b].order) != (nowA->second->order < nowB->second->order))
+                damage.insert(damage.end(), {previous[a].bounds, previous[b].bounds, nowA->second->bounds, nowB->second->bounds});
+        }
+    }
+    return damage;
+}
+
+inline bool affectsSample(const std::vector<Box>& damage, const Box& sample) {
+    return std::ranges::any_of(damage, [&](const Box& box) { return box.overlaps(sample); });
+}
+} // namespace GlassScene
